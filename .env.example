# DG Nagpur WhatsApp Chatbot Configuration
# Copy this file to .env and fill in your actual values

# ===== WhatsApp Business API Configuration =====

# Verify token (create your own random string for security)
# This is used to verify webhook requests from WhatsApp
WHATSAPP_VERIFY_TOKEN=your_secure_verify_token_here

# Access token from Meta/Facebook Developer Portal
# Go to your app → WhatsApp → API Setup → Generate Token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# Phone Number ID from WhatsApp Business Account
# Found in Phone Numbers section of your app
WHATSAPP_PHONE_NUMBER_ID=1234567890123456

# Business Account ID
# Found in your WhatsApp Business Account settings
WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890123456

# API Version (update if Meta releases new versions)
WHATSAPP_API_VERSION=v17.0

# ===== Server Configuration =====

# Enable debug mode (set to False in production)
DEBUG=False

# Port to run the server on
PORT=5000

# Environment
ENVIRONMENT=development

# ===== Agency Contact Information =====

# Agency phone number (with country code, no spaces)
AGENCY_PHONE=+919999999999

# Agency email
AGENCY_EMAIL=info@dgnagpur.com

# Website URL
AGENCY_WEBSITE=www.dgnagpur.com

# Business hours (for out-of-hours messages)
AGENCY_HOURS=9:00 AM - 6:00 PM IST (Monday-Friday)

# ===== Database Configuration =====

# Database file path
DB_PATH=dg_nagpur_leads.db

# ===== Logging Configuration =====

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (optional, leave empty to log to console only)
LOG_FILE=chatbot.log

# ===== Advanced Settings =====

# Message delay in seconds
MESSAGE_DELAY=1

# Typing indicator duration
TYPING_INDICATOR_DURATION=2

# Session timeout (minutes)
SESSION_TIMEOUT=30

# Maximum message length
MAX_MESSAGE_LENGTH=4096

# ===== Optional: Database Backup =====

# Enable automatic backups
ENABLE_BACKUPS=True

# Backup interval (minutes)
BACKUP_INTERVAL=60

# ===== Optional: Analytics =====

# Enable analytics tracking
ENABLE_ANALYTICS=True

# ===== Optional: Integrations =====

# Google Calendar API (for meeting scheduling)
GOOGLE_CALENDAR_TOKEN=

# Email service (for sending confirmations)
SMTP_SERVER=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# CRM Integration (Hubspot, Pipedrive, etc.)
CRM_API_KEY=
CRM_TYPE=hubspot

# ===== Notes =====
# 1. Never commit this file with real values to version control
# 2. Always use environment variables in production
# 3. Rotate access tokens regularly for security
# 4. Keep verify token secure
# 5. Use HTTPS for all API calls
